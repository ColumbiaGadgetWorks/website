;; Zone file for columbiagadgetworks.org, captured from WordPress.com nameservers on 2026-09-20.
;; Import in Cloudflare: DNS → Records → Import and Export → Import DNS records.
;; After the Worker custom domains are added, delete the two apex A records and the www CNAME
;; (Cloudflare manages those), and drop include:_spf.wpcloud.com from SPF once WordPress is gone.
$ORIGIN columbiagadgetworks.org.
$TTL 300

;; Website (WordPress.com), replaced by the Worker custom domain at cutover
@                 IN A     192.0.78.145
@                 IN A     192.0.78.198
www               IN CNAME columbiagadgetworks.org.

;; Google Workspace mail, must be preserved exactly
@                 IN MX    1 smtp.google.com.
@                 IN TXT   "v=spf1 include:_spf.google.com include:_spf.wpcloud.com ~all"
_dmarc            IN TXT   "v=DMARC1;p=none;"
google._domainkey IN TXT   "v=DKIM1;k=rsa;"

;; WordPress.com outbound-mail DKIM, keep until the WordPress.com plan is cancelled
wpcloud1._domainkey IN CNAME wpcloud1._domainkey.wpcloud.com.
wpcloud2._domainkey IN CNAME wpcloud2._domainkey.wpcloud.com.

;; Google domain verification (Workspace / Google-hosted), keep
vgqemn6x7kjj      IN CNAME gv-vze2kqff7cvjlo.dv.googlehosted.com.

;; Not carried over: TXT _domainconnect (WordPress.com's DNS-management hook; meaningless once DNS leaves WordPress.com)

;; Google site verification (Search Console / Workspace)
@                 IN TXT   "google-site-verification=7OnMIWqzxQb5ebmrkrx0HekvmP5aPFsY1En6TJODyAE"
