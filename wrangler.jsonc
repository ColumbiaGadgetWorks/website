{
  // Cloudflare Worker config. `npm install && npx wrangler deploy` builds and deploys.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  // Runs before `wrangler deploy` (locally and in Cloudflare Workers Builds). Hugo comes from the hugo-extended npm package, so the build image's Hugo version does not matter.
  "build": { "command": "npm run build" },
  "main": "src/index.js",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Send /api/* to src/index.js even when a browser opens it directly. Without
    // this, a visit typed into the address bar counts as a page navigation and
    // gets the site's 404 page before the Worker runs (fetch() calls were fine).
    "run_worker_first": ["/api/*"]
  },
  // Email updates list. No id on purpose: Wrangler creates the namespace on the
  // first deploy and keeps it linked afterwards (automatic provisioning, wrangler
  // 4.45+). Workers Builds' default token has KV edit permission, so this needs no
  // manual setup. Do not add a D1 database the same way: that token has no D1 access.
  "kv_namespaces": [{ "binding": "SUBSCRIBERS" }],
  // Shop fund campaigns and donations (db/fund-schema.sql). Created by hand in the
  // dashboard, since the Workers Builds token cannot create D1 databases.
  "d1_databases": [
    { "binding": "FUND_DB", "database_name": "fundraiser", "database_id": "58d072fb-f28b-432f-b0c2-499b85d603d5" }
  ],
  // Do not delete variables/secrets that were set in the dashboard on each deploy.
  "keep_vars": true,
  "vars": {
    // CALENDAR_ICS_URL is NOT here: it is a secret set in the dashboard (see
    // src/calendar.js). A var of the same name would clash with it on deploy.
    // The old fundbot sheet's campaigns endpoint. /api/fund/campaigns uses it only
    // while FUND_DB is not bound; delete it once the D1 database is live.
    "FUNDBOT_API_URL": "https://fundbot.adman.casa/api/campaigns",
    // Default donate link for new /fund campaigns and the /fund list button.
    "DONATE_URL": "https://givebutter.com/v7RxV6",
    // "false" hides donor names on /kiosk/ (Discord still shows them).
    "SHOW_DONORS": "true"
    // Secrets, set in the dashboard (Settings > Variables and Secrets):
    //   DISCORD_PUBLIC_KEY  Discord app public key (/fund commands)
    //   DISCORD_BOT_TOKEN   Discord bot token (edits and pins /fund boards)
  },
  // Hourly: copy upcoming calendar events to the Discord server (src/discord-events.js).
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true }
}
