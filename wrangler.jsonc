{
  // Cloudflare Worker config. `npm install && npx wrangler deploy` builds and deploys.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  // Runs before `wrangler deploy` (locally and in Cloudflare Workers Builds). Hugo comes from the hugo-extended npm package, so the build image's Hugo version does not matter.
  "build": { "command": "npm run build" },
  "main": "src/index.js",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
